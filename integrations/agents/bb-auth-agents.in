#!/usr/bin/env python3
"""bb-auth-agents — wire bb-auth's agent supervision into AI coding harnesses.

Usage:
  bb-auth-agents status
  bb-auth-agents install   [--dry-run] [HARNESS...]
  bb-auth-agents uninstall [--dry-run] [HARNESS...]

Harnesses: claude, codex, gemini, devin, opencode, pi. With no HARNESS,
install/uninstall target every harness that is present (binary on PATH or
config file exists).

Ownership: only entries bb-auth owns are touched — hook commands whose
basename is `bb-auth-intent-hook`, Claude autoMode strings prefixed
`bb-auth:`, and the plugin/extension files named after bb-auth. Install is
remove-ours + add-current, so re-running is a no-op and upgrades a stale hook
path. The first modification of a config file saves `<file>.bb-auth-backup`.
"""
from __future__ import annotations

import argparse
import json
import os
import shutil
import socket
import subprocess
import sys

_VERSION = "@BB_AUTH_VERSION_STRING@"
_HOOK_NAME = "bb-auth-intent-hook"
_MARK = "bb-auth:"

# Claude auto mode classifier entries (prose, read as rules). The environment
# entry tells it how escalation works here; the soft_deny entry tells it that
# routing around a declined prompt is going around the user.
_CLAUDE_ENVIRONMENT = (
    "bb-auth: privilege escalation on this machine is supervised by bb-auth. A PreToolUse "
    "hook rewrites clean `sudo`/`doas` commands to `pkexec` only when polkit will prompt, "
    "and the user approves each one at a bb-auth authentication prompt on their desktop; "
    "the agent never sees or handles the password."
)
_CLAUDE_SOFT_DENY = (
    "bb-auth: after a pkexec command exits 126 or 127 (the user dismissed or failed the "
    "bb-auth authentication prompt), retrying the same privileged action by another route "
    "— sudo -S, SUDO_ASKPASS, su, run0, doas, or editing sudoers or polkit rules — goes "
    "around the user's decision."
)


def _configured(value: str, env: str, fallback: str) -> str:
    """Env override, else the configure_file value, else a source-tree guess."""
    if os.environ.get(env):
        return os.environ[env]
    return fallback if value.startswith("@") else value


_HERE = os.path.dirname(os.path.realpath(__file__))
HOOK = _configured("@BB_AUTH_INTENT_HOOK_PATH@", "BB_AUTH_INTENT_HOOK",
                   os.path.normpath(os.path.join(_HERE, os.pardir, "libexec", _HOOK_NAME)))
INTEGRATIONS = _configured("@BB_AUTH_INTEGRATIONS_DIR@", "BB_AUTH_INTEGRATIONS_DIR",
                           os.path.normpath(os.path.join(_HERE, os.pardir)))


def _home(*parts: str) -> str:
    return os.path.join(os.path.expanduser("~"), *parts)


def _cmd(extra: dict | None = None) -> dict:
    return {"type": "command", **(extra or {}), "command": HOOK}


def _owned_hook(h: object) -> bool:
    if not isinstance(h, dict) or not isinstance(h.get("command"), str):
        return False
    first = h["command"].strip().split(" ", 1)[0]
    return os.path.basename(first) == _HOOK_NAME


# --- JSON hook-config harnesses ---------------------------------------------

# @lat: [[agent-intent#Harness installer]]
class JsonHarness:
    """A harness whose hooks live in a JSON file as {hooks: {Event: [groups]}}."""

    name = ""
    binary = ""
    note = ""

    def path(self) -> str:
        raise NotImplementedError

    def groups(self) -> dict:
        """{event: [matcher groups]} bb-auth wants present."""
        raise NotImplementedError

    def present(self) -> bool:
        return bool(shutil.which(self.binary)) or os.path.exists(self.path())

    def load(self) -> dict:
        try:
            with open(self.path()) as f:
                data = json.load(f)
        except FileNotFoundError:
            return {}
        if not isinstance(data, dict):
            raise ValueError(f"{self.path()}: top level is not a JSON object")
        return data

    def strip(self, data: dict) -> dict:
        hooks = data.get("hooks")
        if not isinstance(hooks, dict):
            return data
        for event in list(hooks):
            groups = hooks[event]
            if not isinstance(groups, list):
                continue
            kept = []
            for g in groups:
                if isinstance(g, dict) and isinstance(g.get("hooks"), list) and any(map(_owned_hook, g["hooks"])):
                    g = {**g, "hooks": [h for h in g["hooks"] if not _owned_hook(h)]}
                    if not g["hooks"]:
                        continue
                kept.append(g)
            if kept:
                hooks[event] = kept
            else:
                del hooks[event]
        if not hooks:
            del data["hooks"]
        return data

    def add(self, data: dict) -> dict:
        hooks = data.setdefault("hooks", {})
        for event, groups in self.groups().items():
            hooks.setdefault(event, []).extend(groups)
        return data

    def owned(self, data: dict) -> list:
        """Canonical, order-free view of the bb-auth entries in `data`."""
        out = []
        for event, groups in (data.get("hooks") or {}).items():
            for g in groups if isinstance(groups, list) else []:
                if not isinstance(g, dict):
                    continue
                for h in g.get("hooks") or []:
                    if _owned_hook(h):
                        meta = {k: v for k, v in g.items() if k != "hooks"}
                        out.append(json.dumps([event, meta, h], sort_keys=True))
        return sorted(out)

    def planned(self, install: bool) -> tuple[dict, dict]:
        before = self.load()
        after = self.strip(json.loads(json.dumps(before)))
        if install:
            after = self.add(after)
        return before, after

    def wired(self, before: dict, after: dict) -> bool:
        # Order-free: a user edit that appends after our entries must not make
        # every install rewrite the file.
        return self.owned(before) == self.owned(after)

    def apply(self, install: bool, dry_run: bool) -> str:
        before, after = self.planned(install)
        if after == before or (install and self.wired(before, after)):
            return "unchanged"
        if dry_run:
            return "would update " + self.path()
        _write_json(self.path(), after)
        return "updated " + self.path()

    def status(self) -> str:
        before, after = self.planned(True)
        if self.wired(before, after):
            return "wired"
        return "stale (re-run install)" if self.owned(before) else "not wired"


class Claude(JsonHarness):
    name, binary = "claude", "claude"

    def path(self):
        base = os.environ.get("CLAUDE_CONFIG_DIR") or _home(".claude")
        return os.path.join(base, "settings.json")

    def groups(self):
        # `if`-gated so the process only spawns on actual escalations.
        pre = [_cmd({"if": f"Bash({tool} *)"}) for tool in ("sudo", "pkexec", "doas")]
        post = [_cmd({"if": "Bash(pkexec *)"})]
        return {
            "PreToolUse": [{"matcher": "Bash", "hooks": pre}],
            "PostToolUse": [{"matcher": "Bash", "hooks": post}],
            "PostToolUseFailure": [{"matcher": "Bash", "hooks": [dict(h) for h in post]}],
        }

    def strip(self, data):
        data = super().strip(data)
        auto = data.get("autoMode")
        if isinstance(auto, dict):
            for key in ("environment", "soft_deny"):
                entries = auto.get(key)
                if not isinstance(entries, list):
                    continue
                kept = [e for e in entries if not (isinstance(e, str) and e.startswith(_MARK))]
                # ["$defaults"] alone is the built-in list — same as absent.
                if kept and kept != ["$defaults"]:
                    auto[key] = kept
                else:
                    del auto[key]
            if not auto:
                del data["autoMode"]
        return data

    def owned(self, data):
        out = super().owned(data)
        auto = data.get("autoMode") if isinstance(data.get("autoMode"), dict) else {}
        for key in ("environment", "soft_deny"):
            entries = auto.get(key) if isinstance(auto.get(key), list) else []
            out += [json.dumps([key, e]) for e in entries if isinstance(e, str) and e.startswith(_MARK)]
        return sorted(out)

    def add(self, data):
        data = super().add(data)
        auto = data.setdefault("autoMode", {})
        for key, entry in (("environment", _CLAUDE_ENVIRONMENT), ("soft_deny", _CLAUDE_SOFT_DENY)):
            # Creating the array bare would replace the built-in rules.
            auto.setdefault(key, ["$defaults"]).append(entry)
        return data


class Codex(JsonHarness):
    name, binary = "codex", "codex"
    note = "codex: run /hooks in the CLI and trust the bb-auth hook (changed hooks need re-review)"

    def path(self):
        return os.path.join(os.environ.get("CODEX_HOME") or _home(".codex"), "hooks.json")

    def present(self):
        return bool(shutil.which(self.binary)) or os.path.isdir(os.path.dirname(self.path()))

    def groups(self):
        return {"PreToolUse": [{"matcher": "Bash", "hooks": [_cmd()]}]}


class Gemini(JsonHarness):
    name, binary = "gemini", "gemini"

    def path(self):
        return _home(".gemini", "settings.json")

    def groups(self):
        return {"BeforeTool": [{"matcher": "^run_shell_command$",
                                "hooks": [_cmd({"name": "bb-auth-intent"})]}]}


class Devin(JsonHarness):
    name, binary = "devin", "devin"

    def path(self):
        return _home(".config", "devin", "config.json")

    def groups(self):
        # Devin's matcher is a tool-name regex with no `if` gate; the hook
        # self-filters privileged prefixes in ~1 ms.
        return {"PreToolUse": [{"matcher": "^exec$", "hooks": [_cmd()]}]}


# --- file drop-in harnesses ---------------------------------------------------

class DropIn:
    """A harness that loads a plugin file from a directory; bb-auth symlinks
    its packaged copy so upgrades propagate."""

    name = binary = rel_source = config_dir = ""
    note = ""

    def target_dir(self) -> str:
        raise NotImplementedError

    def source(self) -> str:
        return os.path.join(INTEGRATIONS, self.rel_source)

    def target(self) -> str:
        return os.path.join(self.target_dir(), os.path.basename(self.rel_source))

    def present(self) -> bool:
        return bool(shutil.which(self.binary)) or os.path.isdir(self.config_dir)

    def status(self) -> str:
        t = self.target()
        if os.path.islink(t):
            return "wired" if os.readlink(t) == self.source() else "stale (re-run install)"
        return "copied file (re-run install to symlink)" if os.path.exists(t) else "not wired"

    def apply(self, install: bool, dry_run: bool) -> str:
        t = self.target()
        exists = os.path.lexists(t)
        if install and os.path.islink(t) and os.readlink(t) == self.source():
            return "unchanged"
        if not install and not exists:
            return "unchanged"
        if install and not os.path.exists(self.source()):
            raise FileNotFoundError(f"{self.source()} missing — is bb-auth installed?")
        verb = "link " + t if install else "remove " + t
        if dry_run:
            return "would " + verb
        if exists:
            if not os.path.islink(t):
                shutil.copy2(t, t + ".bb-auth-backup")
            os.unlink(t)
        if install:
            os.makedirs(self.target_dir(), exist_ok=True)
            os.symlink(self.source(), t)
        return verb


class Opencode(DropIn):
    name, binary = "opencode", "opencode"
    rel_source = os.path.join("opencode", "bb-auth-plugin.js")
    note = "opencode: some versions ignore output.args mutations; declarations still land"

    @property
    def config_dir(self):
        return _home(".config", "opencode")

    def target_dir(self):
        return os.path.join(self.config_dir, "plugins")


class Pi(DropIn):
    name, binary = "pi", "pi"
    rel_source = os.path.join("pi", "bb-auth-extension.ts")
    note = "pi: run /reload in open sessions"

    @property
    def config_dir(self):
        return _home(".pi", "agent")

    def target_dir(self):
        return os.path.join(self.config_dir, "extensions")


HARNESSES = [Claude(), Codex(), Gemini(), Devin(), Opencode(), Pi()]


# --- helpers ------------------------------------------------------------------

def _write_json(path: str, data: dict) -> None:
    if os.path.exists(path) and not os.path.exists(path + ".bb-auth-backup"):
        shutil.copy2(path, path + ".bb-auth-backup")
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".bb-auth-tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=2, ensure_ascii=False)
        f.write("\n")
    if os.path.exists(path):
        shutil.copymode(path, tmp)
    os.replace(tmp, path)


def _daemon_status() -> str:
    runtime = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    path = os.path.join(runtime, "bb-auth.sock")
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(0.5)
            s.connect(path)
            s.sendall(b'{"type":"ping"}\n')
            reply = s.recv(256)
        return "reachable" if b"pong" in reply else f"unexpected reply at {path}"
    except OSError:
        return f"NOT reachable at {path} — hooks will leave commands unchanged"


def _hook_status() -> str:
    if not os.access(HOOK, os.X_OK):
        return f"MISSING at {HOOK}"
    try:
        out = subprocess.run([HOOK, "--version"], capture_output=True, text=True, timeout=5)
        version = out.stdout.strip() or "(pre-0.3 build: no --version)"
    except (OSError, subprocess.SubprocessError):
        version = "(not runnable)"
    return f"{HOOK}  {version}"


def _polkit_status() -> str:
    try:
        rc = subprocess.run(["pkcheck", "--action-id", "org.freedesktop.policykit.exec",
                             "--process", str(os.getpid())],
                            capture_output=True, timeout=2).returncode
    except (OSError, subprocess.SubprocessError):
        return "pkcheck unavailable — hooks will not rewrite sudo"
    return {
        0: "pkexec authorized WITHOUT a prompt (a polkit rule says YES) — hooks will not "
           "rewrite sudo, because nothing would stop the command",
        1: "pkexec not authorized for this user — hooks will not rewrite sudo",
        2: "pkexec prompts — hooks rewrite sudo to the supervised bb-auth prompt",
    }.get(rc, f"pkcheck error (exit {rc}) — hooks will not rewrite sudo")


def _select(names: list) -> list:
    if not names:
        return [h for h in HARNESSES if h.present()]
    by_name = {h.name: h for h in HARNESSES}
    unknown = [n for n in names if n not in by_name]
    if unknown:
        raise SystemExit(f"bb-auth-agents: unknown harness {unknown}; known: {sorted(by_name)}")
    return [by_name[n] for n in names]


def cmd_status(_args) -> int:
    for h in HARNESSES:
        present = "present" if h.present() else "absent "
        try:
            state = h.status()
        except (OSError, ValueError) as e:
            state = f"error: {e}"
        print(f"{h.name:<9} {present}  {state}")
    print()
    print(f"hook      {_hook_status()}")
    print(f"daemon    {_daemon_status()}")
    print(f"polkit    {_polkit_status()}")
    return 0


def cmd_apply(args, install: bool) -> int:
    rc = 0
    targets = _select(args.harness)
    if not targets:
        print("bb-auth-agents: no harnesses detected; name one explicitly", file=sys.stderr)
        return 1
    if install and not os.access(HOOK, os.X_OK):
        print(f"bb-auth-agents: warning: hook binary not found at {HOOK}", file=sys.stderr)
    for h in targets:
        try:
            result = h.apply(install, args.dry_run)
        except (OSError, ValueError) as e:
            print(f"{h.name:<9} error: {e}", file=sys.stderr)
            rc = 1
            continue
        print(f"{h.name:<9} {result}")
        if install and h.note and result != "unchanged":
            print(f"          note: {h.note}")
    if install and not args.dry_run:
        print("Restart running agent sessions so they load the hooks.")
    return rc


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="bb-auth-agents",
        description="Wire bb-auth agent supervision into AI coding harnesses.")
    parser.add_argument("--version", action="version", version=f"bb-auth-agents {_VERSION}")
    sub = parser.add_subparsers(dest="cmd", required=True)
    sub.add_parser("status", help="show per-harness wiring, hook, daemon, and polkit state")
    for name in ("install", "uninstall"):
        p = sub.add_parser(name, help=f"{name} bb-auth entries")
        p.add_argument("--dry-run", action="store_true", help="print planned changes only")
        p.add_argument("harness", nargs="*", help=", ".join(h.name for h in HARNESSES))
    args = parser.parse_args()
    if args.cmd == "status":
        return cmd_status(args)
    return cmd_apply(args, install=args.cmd == "install")


if __name__ == "__main__":
    sys.exit(main())
