#!/usr/bin/env python3
"""aisudo — declare agent intent to bb-auth before a privileged command.

Usage:
  aisudo [-r|--reason TEXT] [--agent NAME] [--json JSON|-] [--dry-run] [--] [LAUNCHER] CMD...
  aisudo --print-shim-dir
  bb-auth-declare ...        (compatibility name, identical grammar)

LAUNCHER (sudo/doas/pkexec) is optional: a bare `aisudo CMD` is treated as
`aisudo sudo CMD`. If a command is given it is exec'd after declaring; a clean
leading `sudo CMD`/`doas CMD` — including the supported option subset
(-n/--non-interactive dropped, -u/--user mapped to --user, -- consumed) — is
rewritten to `pkexec CMD` so the escalation routes through bb-auth's
supervised polkit prompt. Fails open: a daemon that does not answer leaves
COMMAND unchanged and lets it run.

Shim mode: when invoked as `sudo`, `doas`, or `pkexec` (argv[0] basename —
installed as symlinks under <libexec>/bb-auth-shims/), the script activates only
under a recognized agent ancestor: it declares a generic intent
(channel="shim") and applies the same translation rules. With no agent
ancestor it transparently execs the real binary. Passthrough never declares,
so it cannot clobber a real reason declared via the CLI or a harness hook
(the daemon correlates latest-wins per agent).
"""
from __future__ import annotations

import argparse
import json
import os
import re
import select
import shlex
import socket
import sys
import time

_TTL_MS = 20000
_MAX_REASON = 2000
_SHIM_TOOLS = ("sudo", "doas", "pkexec")
_SHIM_REASON = "Agent ran a privileged command without declaring a reason"

# Token-aware agent detection: a process is a known agent only when an argv
# token's basename (or comm/exe name) *is* an alias — never when a needle
# appears anywhere in the cmdline (`vim devin-notes.md` must not activate the
# shim). Mirrors the alias table in src/core/RequestContext.cpp.
_AGENT_ALIASES = {
    "claude": "claude-code", "claude-code": "claude-code",
    "codex": "codex", "codex-cli": "codex",
    "gemini": "gemini-cli", "gemini-cli": "gemini-cli", "agy": "gemini-cli",
    "aider": "aider", "aider-chat": "aider",
    "cursor-agent": "cursor-agent",
    "opencode": "opencode",
    "copilot": "copilot-cli", "copilot-cli": "copilot-cli", "gh-copilot": "copilot-cli",
    "devin": "devin", "devin-cli": "devin",
    # pi runs as `node …/pi-coding-agent/…/cli.js`; the package dir is the
    # signature. Bare `pi` is deliberately absent — it collides with the
    # unrelated Debian `pi` utility of the same name.
    "pi-coding-agent": "pi",
}
_SCRIPT_EXTS = (".js", ".mjs", ".cjs", ".py", ".exe", ".cmd")
_META = re.compile(r"[|&;<>`$()\n]")


def _agent_alias(base: str) -> str | None:
    """Map a basename to an agent kind: exact alias, or alias + script ext
    (codex.js, claude.exe, aider.py)."""
    if base in _AGENT_ALIASES:
        return _AGENT_ALIASES[base]
    for ext in _SCRIPT_EXTS:
        if base.endswith(ext) and base[: -len(ext)] in _AGENT_ALIASES:
            return _AGENT_ALIASES[base[: -len(ext)]]
    return None


def _agent_from_token(token: str) -> str | None:
    """Match a cmdline/exe token: every path segment may be an exact alias
    (real installs live under dirs like /opt/claude-code), plus the basename's
    script-entry form. Segment equality still rejects `devin-notes.md`."""
    segs = [s for s in token.split("/") if s]
    for seg in segs:
        if seg.lower() in _AGENT_ALIASES:
            return _AGENT_ALIASES[seg.lower()]
    return _agent_alias(segs[-1].lower()) if segs else _agent_alias(token.lower())

# Substituted by configure_file at build time; "@…@" survives a source-tree run.
_SHIM_DIR = "@BB_AUTH_SHIM_DIR@"


def _sock_path() -> str:
    runtime = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    return os.path.join(runtime, "bb-auth.sock")


def _detect_agent() -> str | None:
    """Walk up the PPID tree; return the agent kind, or None when not under one."""
    try:
        pid = os.getppid()
        for _ in range(16):
            if pid <= 1:
                break
            try:
                with open(f"/proc/{pid}/status", "r") as f:
                    lines = f.readlines()
                name = ""
                ppid = 0
                uid = -1
                for line in lines:
                    if line.startswith("Name:"):
                        name = line.split(":", 1)[1].strip()
                    elif line.startswith("PPid:"):
                        ppid = int(line.split(":", 1)[1].strip())
                    elif line.startswith("Uid:"):
                        uid = int(line.split(":", 1)[1].strip().split()[0])

                if uid != os.getuid():
                    break

                try:
                    with open(f"/proc/{pid}/cmdline", "r") as f:
                        cmdline = f.read().replace("\x00", " ")
                except Exception:
                    cmdline = ""

                try:
                    exe = os.readlink(f"/proc/{pid}/exe")
                except Exception:
                    exe = ""

                exe_name = os.path.basename(exe).lower() if exe else ""
                if kind := _agent_alias(name.lower()) or _agent_from_token(exe):
                    return kind
                for token in cmdline.split():
                    if kind := _agent_from_token(token):
                        return kind

                if ppid <= 1 or ppid == pid:
                    break
                pid = ppid
            except Exception:
                break
    except Exception:
        pass
    return None


def _declare(reason: str, agent: str, command: str, cwd: str, channel: str = "cli") -> dict:
    payload = {
        "type": "intent.declare",
        "reason": reason[:_MAX_REASON],
        "agent": agent,
        "command": command,
        "cwd": cwd,
        "channel": channel,
        "ttlMs": _TTL_MS,
    }
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(0.5)
            s.connect(_sock_path())
            s.sendall((json.dumps(payload) + "\n").encode())
            s.setblocking(False)
            reply_bytes = bytearray()
            deadline = time.monotonic() + 0.5
            while b"\n" not in reply_bytes and len(reply_bytes) <= 4096:
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    return {"bound": None, "error": "daemon timeout"}
                readable, _, _ = select.select([s], [], [], remaining)
                if not readable:
                    return {"bound": None, "error": "daemon timeout"}
                try:
                    chunk = s.recv(256)
                except BlockingIOError:
                    continue
                if not chunk:
                    break
                reply_bytes.extend(chunk)
            if b"\n" not in reply_bytes or len(reply_bytes) > 4096:
                return {"bound": None, "error": "invalid daemon reply"}
            reply = json.loads(bytes(reply_bytes).split(b"\n", 1)[0].decode())
            if not isinstance(reply, dict) or reply.get("type") != "ok" or type(reply.get("bound")) is not bool:
                return {"bound": None, "error": "invalid daemon reply"}
            return {"bound": reply["bound"], "error": ""}
    except Exception:
        return {"bound": None, "error": "daemon unavailable"}


def _report(status: dict) -> None:
    try:
        if status["bound"] is True:
            print("bb-auth: intent declared", file=sys.stderr)
        elif status["bound"] is False:
            print("bb-auth: intent not bound to a recognized agent; prompt will use human layout", file=sys.stderr)
        else:
            print("bb-auth: intent declaration unavailable; command continues without attribution", file=sys.stderr)
    except (OSError, ValueError):
        pass


def _eprint(msg: str) -> None:
    try:
        print(f"aisudo: {msg}", file=sys.stderr)
    except OSError:
        pass


def _die(msg: str):
    _eprint(msg)
    _eprint("usage: aisudo [-r WHY] [--json JSON|-] [--dry-run] [--] [sudo|doas|pkexec] CMD...")
    raise SystemExit(2)


# @lat: [[agent-intent#Escalation translation]]
def _translate(launcher: str, args: list):
    """Translate `launcher args` to a pkexec argv → (argv, note), or
    (None, decline_reason). Supported option subset for sudo/doas:
    -n/--non-interactive (dropped — the supervised GUI prompt is the
    non-interactive path), -u/--user USER (mapped to pkexec --user), `--`
    (end of options). All other options, env assignments, metacharacters,
    and probe-only invocations (no command) decline.
    """
    if launcher not in ("sudo", "doas"):
        return None, "already pkexec" if launcher == "pkexec" else f"{launcher} is not a translatable launcher"
    i, user, notes = 0, None, []
    while i < len(args):
        a = args[i]
        if a == "--":
            i += 1
            break
        if a in ("-n", "--non-interactive"):
            notes.append("dropped -n: GUI prompt replaces stdin auth")
            i += 1
            continue
        if a in ("-u", "--user"):
            if i + 1 >= len(args):
                return None, f"{launcher} {a} needs a user argument"
            user = args[i + 1]
            i += 2
            continue
        if a.startswith("--user="):
            user = a[len("--user="):]
            i += 1
            continue
        if a.startswith("-u") and len(a) > 2:
            user = a[2:]
            i += 1
            continue
        if a.startswith("-"):
            return None, f"{launcher} {a} not translatable to pkexec"
        if "=" in a:
            return None, "env assignment not translatable to pkexec"
        break
    rest = args[i:]
    if not rest:
        return None, f"{launcher} without a command is a probe; nothing to elevate"
    if any(_META.search(a) for a in rest) or (user is not None and _META.search(user)):
        return None, "shell metacharacters in command; declining"
    argv = ["pkexec"] + (["--user", user] if user else []) + rest
    return argv, "; ".join(notes)


def _real_binary(name: str):
    """First PATH entry resolving to a different file than this script."""
    own = os.path.realpath(__file__)
    for d in os.environ.get("PATH", "").split(os.pathsep):
        cand = os.path.join(d or ".", name)
        try:
            if os.path.isfile(cand) and os.access(cand, os.X_OK) and not os.path.samefile(cand, own):
                return cand
        except OSError:
            continue
    return None


def _exec_real(name: str, argv: list):
    """Exec the real binary past the shim; on resolution failure retry with the
    shim dir stripped from PATH so we cannot re-enter ourselves."""
    real = _real_binary(name)
    if real:
        os.execv(real, [name] + argv)
    shimdir = os.path.dirname(os.path.realpath(__file__))
    env = dict(os.environ)
    env["PATH"] = os.pathsep.join(
        d for d in env.get("PATH", "").split(os.pathsep)
        if os.path.realpath(d or ".") != shimdir
    )
    try:
        os.execvpe(name, [name] + argv, env)
    except OSError:
        os._exit(127)


# @lat: [[agent-intent#PATH shim channel]]
def _shim_mode(tool: str, argv: list) -> None:
    try:
        agent = _detect_agent()
    except Exception:
        agent = None
    translated, _note = _translate(tool, argv) if agent else (None, "")
    if not translated:
        _exec_real(tool, argv)
        return
    try:
        cwd = os.getcwd()
    except OSError:
        cwd = ""
    status = _declare(_SHIM_REASON, agent, " ".join([tool] + argv), cwd, channel="shim")
    if status["bound"] is not None:
        # Daemon answered (bound or not): the supervised path is live — rewrite.
        _exec_real(translated[0], translated[1:])
    else:
        # No daemon to supervise: keep the command on its original auth path.
        _exec_real(tool, argv)


def _shim_dir() -> str:
    if os.environ.get("BB_AUTH_SHIM_DIR"):
        return os.environ["BB_AUTH_SHIM_DIR"]
    if _SHIM_DIR.startswith("@"):
        # Source-tree run: derive <prefix>/libexec/bb-auth-shims from bindir.
        return os.path.normpath(
            os.path.join(os.path.dirname(os.path.realpath(__file__)), os.pardir, "libexec", "bb-auth-shims")
        )
    return _SHIM_DIR


_OPT_VALUE = ("-r", "--reason", "--agent", "--json")
_OPT_FLAG = ("--dry-run", "--print-shim-dir", "-h", "--help")


def _split_args(argv: list):
    """Split leading aisudo options from the command. Known options consume
    their values; the first unknown token — including bare launcher flags
    like `-n` — starts the command (`aisudo -n CMD` means `sudo -n CMD`)."""
    opts, i = [], 0
    while i < len(argv):
        a = argv[i]
        if a == "--":
            i += 1
            break
        if a in _OPT_VALUE:
            if i + 1 >= len(argv):
                _die(f"{a} needs a value")
            opts += [a, argv[i + 1]]
            i += 2
            continue
        if a.split("=", 1)[0] in ("--reason", "--agent", "--json"):
            opts.append(a)
            i += 1
            continue
        if a in _OPT_FLAG or (a.startswith("-r") and len(a) > 2):
            opts.append(a)
            i += 1
            continue
        break
    return opts, argv[i:]


def _parse_json(raw: str) -> dict:
    """--json payload: inline object, or '-' to read it from stdin."""
    if raw == "-":
        raw = sys.stdin.read()
    try:
        obj = json.loads(raw)
    except (json.JSONDecodeError, UnicodeDecodeError) as e:
        _die(f'invalid --json: {e}; expected e.g. \'{{"argv": ["sudo", "make", "install"], "reason": "why"}}\'')
    if not isinstance(obj, dict):
        _die('invalid --json: expected an object like {"argv": ["sudo", "make", "install"]}')
    allowed = ("argv", "command", "reason", "agent", "cwd")
    bad = sorted(set(obj) - set(allowed))
    if bad:
        _die(f"unknown --json keys {bad}; accepted: {list(allowed)}")
    argv = obj.get("argv")
    if argv is not None and (not isinstance(argv, list) or not all(isinstance(a, str) for a in argv)):
        _die("--json 'argv' must be an array of strings")
    cmd_str = obj.get("command")
    if cmd_str is not None and not isinstance(cmd_str, str):
        _die("--json 'command' must be a string")
    if argv is None:
        try:
            argv = shlex.split(cmd_str) if cmd_str else []
        except ValueError as e:
            _die(f"--json 'command' does not split: {e}; pass 'argv' as an array instead")
    for key in ("reason", "agent", "cwd"):
        if obj.get(key) is not None and not isinstance(obj[key], str):
            _die(f"--json '{key}' must be a string")
    return {"argv": argv, "reason": obj.get("reason"), "agent": obj.get("agent"), "cwd": obj.get("cwd")}


class _Parser(argparse.ArgumentParser):
    def error(self, message):
        self.exit(2, f"aisudo: {message}\n"
                     "usage: aisudo [-r WHY] [--json JSON|-] [--dry-run] [--] [sudo|doas|pkexec] CMD...\n")


def _resolve(cmd: list):
    """Split cmd into (launcher, launcher_args, fallback_argv). Bare commands
    normalize to sudo — the name is the verb. Empty cmd → nothing to exec."""
    if not cmd:
        return "", [], []
    if os.path.basename(cmd[0]) in _SHIM_TOOLS:
        return os.path.basename(cmd[0]), cmd[1:], cmd
    return "sudo", cmd, ["sudo"] + cmd


def main() -> None:
    invoked = os.path.basename(sys.argv[0])
    if invoked in _SHIM_TOOLS:
        _shim_mode(invoked, sys.argv[1:])
        return

    parser = _Parser(
        prog="aisudo",
        description="Declare agent intent to bb-auth, then exec the command — "
                    "elevation routes through the supervised polkit prompt.",
        epilog="""\
the name is the verb: `aisudo CMD` ≡ `aisudo sudo CMD` → pkexec. An explicit
sudo/doas/pkexec launcher inside the command is accepted and absorbed.

sudo/doas subset that translates to pkexec: -n/--non-interactive (dropped),
-u/--user USER, --. Other options, VAR=val, and shell metacharacters run
unchanged via their own launcher. `sudo -n` with no command is a probe and
never translates.

JSON mode:  --json '{"argv": ["sudo","make","install"], "reason": "why"}'
            --json -  reads the object from stdin; 'command' (string) is an
            accepted alternative to 'argv'. Optional keys: reason, agent, cwd.
--dry-run   prints {"declare": ..., "exec": ..., "fallback_exec": ...} and
            exits without contacting the daemon or executing anything.""",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("-r", "--reason", help="why (shown at the auth prompt); defaults to the command")
    parser.add_argument("--agent", default=None, help="agent identifier (display/audit only)")
    parser.add_argument("--json", dest="json_input", metavar="JSON|-", help="structured input object, or - for stdin")
    parser.add_argument("--dry-run", action="store_true", help="print the resolved plan and exit")
    parser.add_argument("--print-shim-dir", action="store_true",
                        help="print the installed PATH-shim directory and exit")
    opt_argv, cmd = _split_args(sys.argv[1:])
    args = parser.parse_args(opt_argv)

    if args.print_shim_dir:
        print(_shim_dir())
        return

    reason, agent_override, cwd_override = args.reason, args.agent, None
    if args.json_input is not None:
        if cmd:
            _die("--json cannot be combined with a positional command")
        obj = _parse_json(args.json_input)
        cmd = obj["argv"]
        reason = reason or obj["reason"]
        agent_override = agent_override or obj["agent"]
        cwd_override = obj["cwd"]

    if not cmd and not reason:
        parser.error("--reason is required when no command is given")

    launcher, largs, fallback = _resolve(cmd)
    declared_cmd = " ".join(fallback)
    reason = reason or declared_cmd
    agent = agent_override or _detect_agent() or "agent"
    try:
        cwd = cwd_override or os.getcwd()
    except OSError:
        cwd = cwd_override or ""

    payload = {
        "type": "intent.declare",
        "reason": reason[:_MAX_REASON],
        "agent": agent,
        "command": declared_cmd,
        "cwd": cwd,
        "channel": "cli",
        "ttlMs": _TTL_MS,
    }

    if args.dry_run:
        translated, note = _translate(launcher, largs) if cmd else (None, "")
        plan = {"declare": payload, "exec": translated or fallback, "note": note}
        if translated:
            plan["fallback_exec"] = fallback
        print(json.dumps(plan))
        return

    status = _declare(reason, agent, declared_cmd, cwd)
    _report(status)

    exec_argv = fallback
    if cmd and status["bound"] is not None:
        translated, note = _translate(launcher, largs)
        if translated:
            exec_argv = translated
            detail = f" ({note})" if note else ""
            _eprint(f"{' '.join(fallback)} → {' '.join(exec_argv)}{detail}")
        elif note:
            _eprint(f"{note}; running {' '.join(fallback)} unchanged")

    if exec_argv:
        os.execvp(exec_argv[0], exec_argv)


if __name__ == "__main__":
    main()
