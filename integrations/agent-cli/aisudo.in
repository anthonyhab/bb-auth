#!/usr/bin/env python3
"""bb-auth-declare — declare agent intent to bb-auth before a privileged command.

Usage:
  bb-auth-declare --reason TEXT [--agent NAME] [-- COMMAND...]
  bb-auth-declare --print-shim-dir

If COMMAND is given it is exec'd after declaring; a simple leading `sudo CMD`
is conservatively rewritten to `pkexec CMD` so the escalation routes through
bb-auth's supervised polkit prompt. Fails open: any error leaves COMMAND
unchanged and lets it run.

Shim mode: when invoked as `sudo`, `doas`, or `pkexec` (argv[0] basename —
installed as symlinks under <libexec>/bb-auth-shims/), the script activates only
under a recognized agent ancestor: it declares a generic intent
(channel="shim") and rewrites a clean `sudo CMD`/`doas CMD` to `pkexec CMD`.
With no agent ancestor it transparently execs the real binary. Passthrough
never declares, so it cannot clobber a real reason declared via the CLI or a
harness hook (the daemon correlates latest-wins per agent).
"""
from __future__ import annotations

import argparse
import json
import os
import re
import select
import socket
import sys
import time

_TTL_MS = 20000
_MAX_REASON = 2000
_SHIM_TOOLS = ("sudo", "doas", "pkexec")
_SHIM_REASON = "Agent ran a privileged command without declaring a reason"

# Token-aware agent detection: a process is a known agent only when an argv
# token's basename (or comm/exe name) *is* an alias — never when a needle
# appears anywhere in the cmdline (`vim devin-notes.md` must not activate the
# shim). Mirrors the alias table in src/core/RequestContext.cpp.
_AGENT_ALIASES = {
    "claude": "claude-code", "claude-code": "claude-code",
    "codex": "codex", "codex-cli": "codex",
    "gemini": "gemini-cli", "gemini-cli": "gemini-cli", "agy": "gemini-cli",
    "aider": "aider", "aider-chat": "aider",
    "cursor-agent": "cursor-agent",
    "opencode": "opencode",
    "copilot": "copilot-cli", "copilot-cli": "copilot-cli", "gh-copilot": "copilot-cli",
    "devin": "devin", "devin-cli": "devin",
    # pi runs as `node …/pi-coding-agent/…/cli.js`; the package dir is the
    # signature. Bare `pi` is deliberately absent — it collides with the
    # unrelated Debian `pi` utility of the same name.
    "pi-coding-agent": "pi",
}
_SCRIPT_EXTS = (".js", ".mjs", ".cjs", ".py", ".exe", ".cmd")
_META = re.compile(r"[|&;<>`$()\n]")


def _agent_alias(base: str) -> str | None:
    """Map a basename to an agent kind: exact alias, or alias + script ext
    (codex.js, claude.exe, aider.py)."""
    if base in _AGENT_ALIASES:
        return _AGENT_ALIASES[base]
    for ext in _SCRIPT_EXTS:
        if base.endswith(ext) and base[: -len(ext)] in _AGENT_ALIASES:
            return _AGENT_ALIASES[base[: -len(ext)]]
    return None


def _agent_from_token(token: str) -> str | None:
    """Match a cmdline/exe token: every path segment may be an exact alias
    (real installs live under dirs like /opt/claude-code), plus the basename's
    script-entry form. Segment equality still rejects `devin-notes.md`."""
    segs = [s for s in token.split("/") if s]
    for seg in segs:
        if seg.lower() in _AGENT_ALIASES:
            return _AGENT_ALIASES[seg.lower()]
    return _agent_alias(segs[-1].lower()) if segs else _agent_alias(token.lower())

# Substituted by configure_file at build time; "@…@" survives a source-tree run.
_SHIM_DIR = "@BB_AUTH_SHIM_DIR@"


def _sock_path() -> str:
    runtime = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    return os.path.join(runtime, "bb-auth.sock")


def _detect_agent() -> str | None:
    """Walk up the PPID tree; return the agent kind, or None when not under one."""
    try:
        pid = os.getppid()
        for _ in range(16):
            if pid <= 1:
                break
            try:
                with open(f"/proc/{pid}/status", "r") as f:
                    lines = f.readlines()
                name = ""
                ppid = 0
                uid = -1
                for line in lines:
                    if line.startswith("Name:"):
                        name = line.split(":", 1)[1].strip()
                    elif line.startswith("PPid:"):
                        ppid = int(line.split(":", 1)[1].strip())
                    elif line.startswith("Uid:"):
                        uid = int(line.split(":", 1)[1].strip().split()[0])

                if uid != os.getuid():
                    break

                try:
                    with open(f"/proc/{pid}/cmdline", "r") as f:
                        cmdline = f.read().replace("\x00", " ")
                except Exception:
                    cmdline = ""

                try:
                    exe = os.readlink(f"/proc/{pid}/exe")
                except Exception:
                    exe = ""

                exe_name = os.path.basename(exe).lower() if exe else ""
                if kind := _agent_alias(name.lower()) or _agent_from_token(exe):
                    return kind
                for token in cmdline.split():
                    if kind := _agent_from_token(token):
                        return kind

                if ppid <= 1 or ppid == pid:
                    break
                pid = ppid
            except Exception:
                break
    except Exception:
        pass
    return None


def _declare(reason: str, agent: str, command: str, cwd: str, channel: str = "cli") -> dict:
    payload = {
        "type": "intent.declare",
        "reason": reason[:_MAX_REASON],
        "agent": agent,
        "command": command,
        "cwd": cwd,
        "channel": channel,
        "ttlMs": _TTL_MS,
    }
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(0.5)
            s.connect(_sock_path())
            s.sendall((json.dumps(payload) + "\n").encode())
            s.setblocking(False)
            reply_bytes = bytearray()
            deadline = time.monotonic() + 0.5
            while b"\n" not in reply_bytes and len(reply_bytes) <= 4096:
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    return {"bound": None, "error": "daemon timeout"}
                readable, _, _ = select.select([s], [], [], remaining)
                if not readable:
                    return {"bound": None, "error": "daemon timeout"}
                try:
                    chunk = s.recv(256)
                except BlockingIOError:
                    continue
                if not chunk:
                    break
                reply_bytes.extend(chunk)
            if b"\n" not in reply_bytes or len(reply_bytes) > 4096:
                return {"bound": None, "error": "invalid daemon reply"}
            reply = json.loads(bytes(reply_bytes).split(b"\n", 1)[0].decode())
            if not isinstance(reply, dict) or reply.get("type") != "ok" or type(reply.get("bound")) is not bool:
                return {"bound": None, "error": "invalid daemon reply"}
            return {"bound": reply["bound"], "error": ""}
    except Exception:
        return {"bound": None, "error": "daemon unavailable"}


def _report(status: dict) -> None:
    try:
        if status["bound"] is True:
            print("bb-auth: intent declared", file=sys.stderr)
        elif status["bound"] is False:
            print("bb-auth: intent not bound to a recognized agent; prompt will use human layout", file=sys.stderr)
        else:
            print("bb-auth: intent declaration unavailable; command continues without attribution", file=sys.stderr)
    except (OSError, ValueError):
        pass


def _rewrite_sudo(argv: list) -> list:
    """Rewrite a plain `sudo CMD` → `pkexec CMD`. Conservative: no options, no
    env=val, no shell metacharacters in ANY argument — parity with the harness
    hook's refusal class (openspec add-agent-path-shim spec)."""
    if not argv or argv[0] != "sudo" or len(argv) < 2:
        return argv
    rest = argv[1:]
    if rest[0].startswith("-") or "=" in rest[0]:
        return argv
    if any(_META.search(a) for a in rest):
        return argv
    return ["pkexec"] + rest


def _shim_rewrite(tool: str, argv: list):
    """sudo/doas → pkexec for a clean leading `tool CMD`; otherwise None."""
    if tool not in ("sudo", "doas") or not argv:
        return None
    if argv[0].startswith("-") or "=" in argv[0]:
        return None
    if any(_META.search(a) for a in argv):
        return None
    return ["pkexec"] + argv


def _real_binary(name: str):
    """First PATH entry resolving to a different file than this script."""
    own = os.path.realpath(__file__)
    for d in os.environ.get("PATH", "").split(os.pathsep):
        cand = os.path.join(d or ".", name)
        try:
            if os.path.isfile(cand) and os.access(cand, os.X_OK) and not os.path.samefile(cand, own):
                return cand
        except OSError:
            continue
    return None


def _exec_real(name: str, argv: list):
    """Exec the real binary past the shim; on resolution failure retry with the
    shim dir stripped from PATH so we cannot re-enter ourselves."""
    real = _real_binary(name)
    if real:
        os.execv(real, [name] + argv)
    shimdir = os.path.dirname(os.path.realpath(__file__))
    env = dict(os.environ)
    env["PATH"] = os.pathsep.join(
        d for d in env.get("PATH", "").split(os.pathsep)
        if os.path.realpath(d or ".") != shimdir
    )
    try:
        os.execvpe(name, [name] + argv, env)
    except OSError:
        os._exit(127)


# @lat: [[agent-intent#PATH shim channel]]
def _shim_mode(tool: str, argv: list) -> None:
    try:
        agent = _detect_agent()
    except Exception:
        agent = None
    rewritten = _shim_rewrite(tool, argv) if agent else None
    if not rewritten:
        _exec_real(tool, argv)
        return
    try:
        cwd = os.getcwd()
    except OSError:
        cwd = ""
    status = _declare(_SHIM_REASON, agent, " ".join([tool] + argv), cwd, channel="shim")
    if status["bound"] is not None:
        # Daemon answered (bound or not): the supervised path is live — rewrite.
        _exec_real(rewritten[0], rewritten[1:])
    else:
        # No daemon to supervise: keep the command on its original auth path.
        _exec_real(tool, argv)


def _shim_dir() -> str:
    if os.environ.get("BB_AUTH_SHIM_DIR"):
        return os.environ["BB_AUTH_SHIM_DIR"]
    if _SHIM_DIR.startswith("@"):
        # Source-tree run: derive <prefix>/libexec/bb-auth-shims from bindir.
        return os.path.normpath(
            os.path.join(os.path.dirname(os.path.realpath(__file__)), os.pardir, "libexec", "bb-auth-shims")
        )
    return _SHIM_DIR


def main() -> None:
    invoked = os.path.basename(sys.argv[0])
    if invoked in _SHIM_TOOLS:
        _shim_mode(invoked, sys.argv[1:])
        return

    parser = argparse.ArgumentParser(
        description="Declare agent intent to bb-auth before a privileged command.",
        epilog="COMMAND is optional; if given, sudo is rewritten to pkexec and the process is replaced.",
    )
    parser.add_argument("--reason", help="Why the command is being run (shown at auth prompt)")
    parser.add_argument("--agent", default=None, help="Agent identifier (display/audit only)")
    parser.add_argument("--print-shim-dir", action="store_true",
                        help="Print the installed PATH-shim directory and exit")
    parser.add_argument("command", nargs=argparse.REMAINDER)
    args = parser.parse_args()

    if args.print_shim_dir:
        print(_shim_dir())
        return

    if not args.reason:
        parser.error("--reason is required")

    cmd = args.command
    if cmd and cmd[0] == "--":
        cmd = cmd[1:]

    agent = args.agent or _detect_agent() or "agent"
    try:
        cwd = os.getcwd()
    except OSError:
        cwd = ""
    declaration_status = _declare(args.reason, agent, " ".join(cmd), cwd)
    _report(declaration_status)
    rewritten = _rewrite_sudo(cmd) if declaration_status["bound"] is True else cmd

    if rewritten:
        os.execvp(rewritten[0], rewritten)


if __name__ == "__main__":
    main()
